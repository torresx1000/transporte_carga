# Preserve the existing MySQL setup unless PostgreSQL is provisioned.
APP_ENV=development
DATABASE_URL=mysql+pymysql://user:password@localhost/transporte
# PostgreSQL option: postgresql+psycopg://user:password@localhost/transporte
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:3000
